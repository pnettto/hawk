{
  "manifest_version": 3,
  "name": "Hawk",
  "version": "1.0",
  "description": "A dark minimal new tab with hourly checklist.",
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "host_permissions": [
    "https://hawk.pnetto.store/*",
    "https://hawk.pedro-535.workers.dev/*"
  ]
}
