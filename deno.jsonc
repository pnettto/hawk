{
  "deploy": {
    "org": "pnettto",
    "app": "hawk"
  },
  "imports": {
    "hono": "npm:hono@^4.11.1",
    "marked": "npm:marked@^17.0.1"
  },
  "tasks": {
    // Dev: Vite serves the frontend on :5173 and proxies API to Hono on :8000.
    // Vite/npm scripts are wrapped in `sh -c` so the real Node runs them (Deno's task shell
    // would otherwise intercept the npm script and re-execute via its own Node compat layer).
    "dev": "sh -c './app/node_modules/.bin/concurrently -n server,client -c blue,green \"deno task dev:server\" \"deno task dev:client\"'",
    "dev:server": "deno run --allow-net --allow-env --allow-read --unstable-kv --env --watch=server,main.ts main.ts",
    "dev:client": "sh -c 'cd app && npm run dev'",
    // Build: produce app/dist for prod (Hono serves it).
    "build": "sh -c 'cd app && npm install && npm run build'",
    "start": "deno run --allow-net --allow-env --allow-read --unstable-kv --env main.ts",
    "deploy": "deno task build && deno deploy --org pnettto --app hawk --prod",
    "test": "sh -c 'cd app && npm test'"
  }
}
