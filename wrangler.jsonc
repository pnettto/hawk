{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hawk",
  "main": "server/worker.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },

  // Prod answers on the custom domain (pnetto.store is a zone in this
  // account; Cloudflare creates the DNS record and certificate) and on
  // hawk.pedro-535.workers.dev.
  "routes": [{ "pattern": "hawk.pnetto.store", "custom_domain": true }],
  "workers_dev": true,

  // The SPA (built by Vite). Unknown paths fall back to index.html; /api and
  // /shared go to the Worker first.
  "assets": {
    "directory": "./app/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/shared/*"]
  },

  // One instance holds all data (SQLite) and the sync sockets.
  "durable_objects": {
    "bindings": [{ "name": "HAWK", "class_name": "HawkDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HawkDO"] }],

  // File bodies, object key "files/<id>". Same bucket the Deno app wrote to.
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "hawk-files" }],

  // Share page templates are imported as strings.
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],

  // Secrets (set with `wrangler secret put [--env preview]`): API_KEY

  // `wrangler preview --name <branch>` → one Preview per PR under this Worker
  // (.github/scripts/deploy.sh). Cloudflare gives each Preview its own Durable
  // Object namespace, so each starts with empty data, deleted with the Preview.
  // Previews don't inherit the settings above. The password (API_KEY) comes
  // from `wrangler preview base-config secret put API_KEY`.
  "previews": {
    "durable_objects": {
      "bindings": [{ "name": "HAWK", "class_name": "HawkDO" }]
    },
    // Shared by all Previews; file ids are random, so they don't clash.
    "r2_buckets": [{ "binding": "FILES", "bucket_name": "hawk-files-preview" }]
  },

  // Legacy shared preview: `wrangler deploy --env preview` →
  // hawk-preview.<subdomain>.workers.dev. Still used for branches made before
  // the `previews` block existed. Remove once those are gone.
  "env": {
    "preview": {
      // workers.dev only; must not inherit the prod custom domain.
      "routes": [],
      "workers_dev": true,
      "durable_objects": {
        "bindings": [{ "name": "HAWK", "class_name": "HawkDO" }]
      },
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "hawk-files-preview" }]
    }
  }
}
